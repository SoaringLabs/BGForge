<Bindings>
    <!--
        WoW 会自动从插件根目录加载本文件，不需要（也不应该）在 TOC 里声明。
        动作名 BIAOGE 与以下两处必须严格一致，否则设置面板的绑定控件读不到键、键也不会生效：
          Core/DB/Init2.lua   BINDING_HEADER_BIAOGE / BINDING_NAME_BIAOGE  —— 提供分类名与显示名
          Core/Options.lua    O.CreateBindKey(..., "BIAOGE", L["表格快捷键"]) —— 面板内的绑定控件
        RoleOverview 只切换当前角色的团本锁定界面，不读取或展示其他角色。
    -->
    <Binding name="BIAOGE" Category="BINDING_HEADER_BIAOGE">
        if BG and BG.MainFrame then BG.MainFrame:SetShown(not BG.MainFrame:IsVisible()) end
    </Binding>
    <Binding name="RoleOverview" Category="BINDING_HEADER_BIAOGE">
        if BG and BG.ToggleRaidLockoutOverview then BG.ToggleRaidLockoutOverview() end
    </Binding>
</Bindings>
